# Copy to .env.local and fill in before collecting real applications.
# All values are inlined into the browser bundle at build time. Never put a
# secret here: anything prefixed with NEXT_PUBLIC_ is public.

# Canonical origin used for metadata, sitemap and robots. No trailing slash.
# Set this to https://community.codeyaar.tech in the production deployment
# environment so the sitemap contains production URLs.
NEXT_PUBLIC_SITE_URL=https://community.codeyaar.tech

# HTTPS endpoint that accepts the application envelope documented in
# docs/04-technical/FORM-SUBMISSION-ARCHITECTURE.md.
# Leave empty to keep submission disabled: the form stays usable, the draft is
# preserved, and pressing submit shows an honest "not configured" message.
# Used by both The First 100 application (/apply) and the Ambassador
# application (/ambassadors/apply).
NEXT_PUBLIC_APPLICATION_ENDPOINT=

# Optional key sent as the X-Application-Key header. Only for public,
# rate-limited identifiers — this value is visible to every visitor.
NEXT_PUBLIC_APPLICATION_PUBLIC_KEY=

# Optional request timeout in milliseconds. Clamped to 5000–60000. Default 20000.
NEXT_PUBLIC_APPLICATION_TIMEOUT_MS=20000

# Web3Forms access key. Set this to the key you obtain from
# https://web3forms.com and the form will submit to their API.
# Leave empty to keep submission disabled and show the "not configured" message.
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=

# ============================================================================
# Code Yaar Community API (Cloudflare Worker) integration
# ============================================================================

# Deployed Worker base URL. No trailing slash.
# Production: https://api.community.codeyaar.tech
# Local dev: http://localhost:8787
NEXT_PUBLIC_COMMUNITY_API_URL=

# Supabase Auth (frontend uses Supabase Auth for session; backend verifies JWT)
# Never put service_role or any secret here — these are public anon values.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional request timeout for Community API calls (ms). Clamped 5000–60000.
NEXT_PUBLIC_API_TIMEOUT_MS=20000

# Cloudflare Turnstile site key for public application/referral submission.
# Obtain from Cloudflare dashboard. Visible in page source — not a secret.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Program UUIDs (seeded in Supabase via migration 001_initial_schema.sql).
# Obtain from the Supabase dashboard or by querying the programs table.
NEXT_PUBLIC_PROGRAM_ID_FOUNDING_COHORT=
NEXT_PUBLIC_PROGRAM_ID_AMBASSADOR=
